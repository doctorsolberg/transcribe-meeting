# Copy to .env (or to the path in TRANSCRIBE_ENV_FILE) and fill in what you need.
# Never commit .env — .gitignore already excludes it.

# OpenAI-compatible API key for readable (LLM transcript cleanup).
OPENAI_API_KEY=

# Base URL, if you're using an OpenAI-compatible provider instead of OpenAI itself.
OPENAI_BASE_URL=

# Groq key for the network ASR model (--asr-models groq-whisper-large-v3).
GROQ_API_KEY=

# Deepgram key: network ASR model (--asr-models deepgram-nova-3) and/or diarization
# (--diarization-provider deepgram) in one request for the whole meeting. Audio goes
# out to Deepgram; neither of these routes is enabled by default.
DEEPGRAM_API_KEY=

# Hugging Face token: needed by `setup` to download the VAD segmentation-3.0
# (always) and, with --diarization-provider pyannote, Community-1.
HF_TOKEN=
