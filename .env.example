# Copy to .env (or to the path in TRANSCRIBE_ENV_FILE) and fill in what you need.
# Restrict the copy to owner access (chmod 600) before adding secrets. Never commit it.

# OpenAI-compatible API key for readable (sends transcript text and context, not audio).
OPENAI_API_KEY=

# Optional base URL for an OpenAI-compatible provider; verify it before using a real key.
# HTTPS is required unless using a literal loopback IP, which can also be keyless.
# Configure a custom endpoint and its key together here or together in the environment.
OPENAI_BASE_URL=

# Optional overrides for the readable pass. Leave blank to use the defaults.
# API: responses (default) or chat. Format: json_schema (default) or json_object.
TRANSCRIBE_READABLE_API=
TRANSCRIBE_READABLE_RESPONSE_FORMAT=
TRANSCRIBE_READABLE_BATCH_SIZE=
# none omits the parameter; other options: low, medium, high.
TRANSCRIBE_READABLE_REASONING=

# Optional trusted HTTPS directory containing the original GigaAM checkpoint files.
TRANSCRIBE_GIGAAM_BASE_URL=

# Groq key for --asr-models groq-whisper-large-v3. Sends audio and can send a prompt
# built from the meeting context and glossary, independent of --clean.
GROQ_API_KEY=

# Deepgram key: network ASR model (--asr-models deepgram-nova-3) and/or diarization
# (--diarization-provider deepgram) in one request for the whole meeting. Audio goes
# out to Deepgram; neither of these routes is enabled by default.
DEEPGRAM_API_KEY=

# Hugging Face Read token for downloading the gated setup models: segmentation-3.0
# for the default route, plus Community-1 for pyannote/all. Accept the terms with
# the token's account and allow access to those repos if using a fine-grained token.
# Only needed for missing gated downloads, not to use the local models afterward.
HF_TOKEN=
